namespace: OwlDomain.Owl.Config.CodeAnalysis.Syntax

# Define the shadowing order
shadow: concrete declared

# Define what's on each token
token concrete:
token declared:

# Define what's on each node in the tree
tree concrete:
tree declared:

# Define the root node in the tree
document: document_unit unit, token end_of_input

## Document types
group document_unit
package document_unit: list<statement> statements
package @ declared : IPackage package

workspace document_unit: list<statement> statements
config document_unit: list<statement> statements

## Property keys
group property_key
empty property_key:
named property_key: token name
nested property_key: property_key left, token accessor, token name

## Property values
group property_value
empty property_value:
named property_value: token name
nested property_value: property_value left, token accessor, token name

## Statements
group statement
empty statement:
only_terminated statement: token terminator
property statement: property_key key, token separator, property_value value, token? terminator
property_scope statement: property_key key, token start, list<statement> statements, token end
